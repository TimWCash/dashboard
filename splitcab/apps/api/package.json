{
  "name": "@splitcab/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ops": "tsx --env-file-if-exists=.env src/ops-cli.ts",
    "simulate": "tsx sim/simulate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@splitcab/core": "*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
