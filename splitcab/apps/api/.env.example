# Copy to .env for local development. In production, set these in your host's secret manager.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@127.0.0.1:5432/splitcab
# Managed Postgres (Neon, Supabase, RDS) usually needs SSL.
DATABASE_SSL=false
# The provider's CA certificate (PEM) when it isn't publicly signed, e.g. Supabase's pooler. Implies SSL.
DATABASE_SSL_CA=
# true behind a transaction-mode pooler (Supabase port 6543, PgBouncer). Set the timeouts on the role instead.
DATABASE_TRANSACTION_POOLER=false
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Comma-separated browser origins allowed to call the API (only needed for the web dev build).
CORS_ORIGINS=http://localhost:8081
# Proxies in front of the API: 0 if clients connect directly, 1 behind one PaaS load balancer. Rate limits use the
# client IP this reveals, so production refuses to start until it's set explicitly.
TRUST_PROXY_HOPS=0
# Countries whose mobile numbers can sign in (ISO codes). GB covers every +44 number.
ALLOWED_PHONE_COUNTRIES=IE,GB

# Sign-in codes. "dev" returns the code in the API response; production must use twilio ("demo" is for DEMO_MODE).
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Store review account: a number nobody owns and a fixed 6-digit code. Leave empty to disable.
REVIEW_PHONE=
REVIEW_CODE=

# The public shared demo only (see the README): codes on screen (OTP_PROVIDER=demo), test payments, and a
# pretend traveller for anyone left unmatched after DEMO_PARTNER_AFTER_S seconds. Never on the real service.
DEMO_MODE=false
DEMO_PARTNER_AFTER_S=45
# Who runs the demo (a person or company), named in its privacy notice. SUPPORT_EMAIL is the contact shown.
DEMO_OPERATOR=

# Payments. "test" needs no Stripe account; production must use stripe with live keys.
PAYMENTS_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MERCHANT_DISPLAY_NAME=SplitCab
# Printed on receipts: legal name, address and VAT number.
RECEIPT_COMPANY_DETAILS=

# Place search. "builtin" uses a fixed list of Irish places; "google" needs a Places API (New) key.
PLACES_PROVIDER=builtin
GOOGLE_MAPS_API_KEY=

# Push notifications. "log" prints them; production must use expo.
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# Extra words the chat filter rejects, comma-separated.
BLOCKED_TERMS=

TERMS_URL=https://splitcab.ie/terms
PRIVACY_URL=https://splitcab.ie/privacy
SUPPORT_EMAIL=support@splitcab.ie
