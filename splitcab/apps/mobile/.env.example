# Where the app finds the API. For an Android emulator talking to your computer use http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Optional: shown on the FREENOW button. FREENOW has no public deep link, so this opens their site or store page.
EXPO_PUBLIC_FREENOW_URL=https://www.free-now.com/ie/
# Optional: register an app at developer.uber.com and set its client id to attribute deep links.
EXPO_PUBLIC_UBER_CLIENT_ID=
# Build-time settings (set as EAS environment variables for cloud builds)
APP_BUNDLE_ID=ie.splitcab.app
EAS_PROJECT_ID=
APPLE_PAY_MERCHANT_ID=
